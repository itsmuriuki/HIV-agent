    "priority": "P1",
    "consciousness": "unconscious",
    "breathing": "laboured",
    "activelyBleeding": true,
    "medicalHistory": "none known"
  }
}


# =============================================================================
# SECTION 8 — EXPECTED ERROR RESPONSES (422 VALIDATION)
# =============================================================================

### 8.1 Missing request body entirely
# Expected: 422 Unprocessable Entity — Field required: body
POST {{base_url}}/em_protocols_rag
Content-Type: {{content_type}}


### 8.2 Missing incidentInfo.description (required field)
# Expected: 422 Unprocessable Entity
POST {{base_url}}/em_protocols_rag
Content-Type: {{content_type}}

{
  "dispatchId": "DISP-ERR-001",
  "patientInfo": {
    "ageGroup": "adult",
    "approxAge": "30",
    "sex": "male"
  },
  "incidentInfo": {
    "priority": "P1",
    "consciousness": "unconscious",
    "breathing": "absent",
    "activelyBleeding": false,
    "medicalHistory": ""
  }
}


### 8.3 Wrong content type — plain text body
# Expected: 422 Unprocessable Entity
POST {{base_url}}/em_protocols_rag
Content-Type: text/plain

Patient collapsed, not breathing, no pulse
