  "incidentInfo": {
    "description": "23-year-old male, gunshot wound to the abdomen, profuse bleeding, unresponsive",
    "priority": "P1",
    "consciousness": "unconscious",
    "breathing": "laboured",
    "activelyBleeding": true,
    "medicalHistory": "none known"
  }
}


