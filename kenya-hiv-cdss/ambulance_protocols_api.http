### 7.1 Minimal input — single symptom description
# Expected: agent still returns a protocol response, no crash
POST {{base_url}}/em_protocols_rag
Content-Type: {{content_type}}

{
  "dispatchId": "DISP-023",
  "patientInfo": {
    "ageGroup": "adult",
    "approxAge": "",
    "sex": ""
  },
  "incidentInfo": {
    "description": "patient unconscious",
    "priority": "P1",
    "consciousness": "unconscious",
    "breathing": "absent",
    "activelyBleeding": false,
    "medicalHistory": ""
  }
}


### 7.2 Bystander language — colloquial Kenyan English
# Tests how well the RAG handles non-clinical layperson descriptions
# Expected: agent extracts relevant protocols despite informal language
POST {{base_url}}/em_protocols_rag
Content-Type: {{content_type}}

{
  "dispatchId": "DISP-024",
  "patientInfo": {
    "ageGroup": "adult",
    "approxAge": "40",
    "sex": "male"
  },
  "incidentInfo": {
    "description": "He got shot in the stomach and there is blood everywhere and he has fallen down and we cannot wake him up",
    "priority": "P1",
    "consciousness": "unconscious",
    "breathing": "laboured",
    "activelyBleeding": true,
    "medicalHistory": "none known"
  }
}


