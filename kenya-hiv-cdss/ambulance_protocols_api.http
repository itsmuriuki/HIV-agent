    "ageGroup": "adult",
    "approxAge": "30",
    "sex": "male"
  },
  "incidentInfo": {
    "description": "GSW abdomen, unresponsive, GCS 6, BP 70 systolic, HR 140, profuse haemorrhage from entry wound",
